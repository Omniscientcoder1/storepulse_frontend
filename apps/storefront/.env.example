NEXT_PUBLIC_API_URL=http://localhost:8000

# FE-12: shared secret sent as X-Internal-Secret on middleware.ts's call to
# the backend's GET /internal/tenant-lookup. Server-only (no NEXT_PUBLIC_
# prefix — never sent to the browser). Must match the backend's own
# INTERNAL_API_SECRET. Can be left unset in local dev when the backend's
# ENVIRONMENT=development (it then skips the secret check); required once the
# backend enforces it.
INTERNAL_API_SECRET=

# FE-10 fallback only: used when middleware.ts didn't run for a request at
# all (e.g. running this app without exercising middleware, for isolated
# component work) — normal requests are tenant-resolved from the real Host
# header by middleware.ts, not this variable. Set to a real tenant UUID from
# your local dev DB (an "electronics"-category tenant with at least one
# active product) to see live data in that scenario; if unset, the page falls
# back to lib/demo-content.ts's static demo product.
STOREFRONT_DEMO_TENANT_ID=
