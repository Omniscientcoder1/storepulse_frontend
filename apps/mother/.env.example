NEXT_PUBLIC_API_URL=http://localhost:8000

# Cross-app link target for the "Log in" CTA — the mother site has no
# session of its own, admin owns the actual login page.
NEXT_PUBLIC_ADMIN_URL=https://app.storepulse.com

# Used to build the wa.me contact link (digits only, country code first,
# e.g. 8801XXXXXXXXX). Leave unset in local dev; the contact link falls back
# to a bare https://wa.me/ if this isn't set.
NEXT_PUBLIC_WHATSAPP_NUMBER=
